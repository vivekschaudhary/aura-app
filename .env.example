# Supabase (provision in dashboard; region: ap-south-1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Vercel AI Gateway (provider keys flow through gateway)
AI_GATEWAY_API_KEY=

# Anthropic Claude (routed via AI Gateway)
ANTHROPIC_API_KEY=

# OpenAI (routed via AI Gateway)
OPENAI_API_KEY=

# Sarvam AI — primary vernacular ASR/TTS (Hindi + Indian-English) per
# architecture amendment 2026-05-26 (supersedes the original Bhashini-primary
# decision). India-region inference; DPDPA-residency preserved.
SARVAM_API_KEY=

# AI4Bharat OSS models (DR fallback) — self-hosted on Modal / Fly if Sarvam
# suffers a sustained outage. No env vars needed until a self-host inference
# endpoint exists; URL placeholder for future use.
AURA_SPEECH_DR_ENDPOINT=

# Bhashini / AI4Bharat platform (legacy / no longer primary as of 2026-05-26).
# Left here in case the gov-platform path is ever wanted as a secondary
# fallback. Skip provisioning unless a successor /ops re-promotes it.
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_INFERENCE_API_KEY=

# MSG91 (SMS OTP fallback for auth)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Tele-MANAS (crisis escalation reference)
TELE_MANAS_HELPLINE=14416

# WebAuthn / Passkeys (AUR-5)
# RP_ID is the registrable domain (e.g. aura.app); ORIGIN is the full URL the
# client connects to (https://aura.app for prod, http://localhost:3000 for dev).
# Signing secrets must be ≥32 bytes of entropy — generate with `openssl rand -base64 32`.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Aura
WEBAUTHN_ORIGIN=
WEBAUTHN_SIGNING_SECRET=
SESSION_SIGNING_SECRET=

# Mobile-side (Expo) — points the tRPC client at the web API.
# Set via EAS Secrets for preview/production builds (see OPS-001).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
