# React Native + Expo + Metro do not play well with pnpm's default strict
# isolation. Metro resolves modules from file-relative paths; expo-router's
# transitive imports (e.g. @expo/metro-runtime) live inside .pnpm/... where
# the dep graph is split across versioned sub-folders and Metro can't reach
# the consumer-level symlinks.
#
# node-linker=hoisted makes pnpm install like npm/yarn (flat node_modules,
# no .pnpm/ private store). This is the community-standard fix for RN/Expo
# monorepos under pnpm.
#
# Trade-off: less strict dep isolation, slightly bigger node_modules. Worth it.
node-linker=hoisted

# Keep React + RN single-instance to prevent two-copies errors.
# (Belt-and-braces with the metro.config.js extraNodeModules pinning.)
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-native-*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=metro
public-hoist-pattern[]=metro-*
